{
  "editorconfig": true,
  "singleQuote": true,
  "bracketSameLine": false,
  "printWidth": 120,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": ["**/*.html", "**/*.json"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": ["*.page.html"],
      "options": {
        "parser": "angular"
      }
    }
  ]
}
