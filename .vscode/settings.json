{
  "i18n-ally.localesPaths": "src/assets/i18n",
  "i18n-ally.keystyle": "nested",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [
    120
  ],
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSaveMode": "file"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSaveMode": "file"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSaveMode": "file"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSaveMode": "file"
  },
  // Ionic foreslo å legge til disse, men da finner ikke VSCode en eneste
  // ionic import av seg selv. Kommenterer ut dette, men pass på å alltid
  // importere fra @Ionic/*/standalone nå som vi har gått over til standalone.
  // "typescript.preferences.autoImportFileExcludePatterns": [
  //   "@ionic/angular/common",
  //   "@ionic/angular"
  // ]
}